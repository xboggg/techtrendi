# /etc/techtrendi-careers/staging.env  — NAMES ONLY in git. Fill values on the server, chmod 600.
CAREERS_ENV=staging
CAREERS_BIND_HOST=127.0.0.1
CAREERS_BIND_PORT=<PORT>
CAREERS_LOG_LEVEL=INFO
# API role (member of careers_api)
CAREERS_DATABASE_URL=postgresql://careers_staging_api:<password>@127.0.0.1:5432/careers_staging
# Worker role (member of careers_worker) — only in worker-*.env files
CAREERS_WORKER_DATABASE_URL=postgresql://careers_staging_worker:<password>@127.0.0.1:5432/careers_staging
CAREERS_WORKER_KINDS=noop
# Migrator — only used when running migrate.py by hand; may be omitted from service env files
CAREERS_MIGRATOR_DATABASE_URL=postgresql://careers_staging_migrator:<password>@127.0.0.1:5432/careers_staging
# Supabase Auth (self-hosted): JWT secret from the Supabase stack's env (JWT_SECRET), and the public URL
CAREERS_JWT_SECRET=<supabase JWT_SECRET>
CAREERS_JWT_ISSUER=https://<supabase public host>/auth/v1
CAREERS_JWT_AUDIENCE=authenticated

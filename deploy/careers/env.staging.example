# /etc/techtrendi-careers/staging.env  — NAMES ONLY in git. Values live on the server, mode 640 root:techtrendi-careers.
#
# HOW TO REACH THE SUPABASE DATABASE (verified on server 144, 6 Nov 2026):
#   127.0.0.1:5432 is NOT Supabase: it is the separate PostgreSQL 16 cluster used by TrendiCars.
#   supabase-db publishes no host port. Use the Supavisor pooler in SESSION mode on 127.0.0.1:5433,
#   with the user written as <role>.<POOLER_TENANT_ID> (tenant id from the supabase-pooler container env).
#   The pooler passes the database name through, so /careers_staging reaches the staging database.
CAREERS_ENV=staging
CAREERS_BIND_HOST=127.0.0.1
CAREERS_BIND_PORT=5121
CAREERS_LOG_LEVEL=INFO
# API role (member of careers_api)
CAREERS_DATABASE_URL=postgresql://careers_staging_api.<tenant>:<password>@127.0.0.1:5433/careers_staging
# Supabase Auth (self-hosted): GOTRUE_JWT_SECRET from the supabase-auth container env
CAREERS_JWT_SECRET=<supabase JWT secret>
CAREERS_JWT_ISSUER=https://db2.techtrendi.com/auth/v1
CAREERS_JWT_AUDIENCE=authenticated

# --- separate files on the server, not in staging.env ---
# worker-staging-noop.env:  CAREERS_ENV, CAREERS_WORKER_KINDS=noop,
#   CAREERS_WORKER_DATABASE_URL=postgresql://careers_staging_worker.<tenant>:<password>@127.0.0.1:5433/careers_staging
# migrator-staging.env (600, root only):
#   CAREERS_MIGRATOR_DATABASE_URL=postgresql://careers_staging_migrator.<tenant>:<password>@127.0.0.1:5433/careers_staging
# readonly-staging.env (600, root only): CAREERS_READONLY_DATABASE_URL=...careers_staging_readonly...

# TechTrendi Careers service — variable NAMES only. Real values live in the
# server's env file (e.g. /etc/techtrendi-careers/careers.env, mode 600), never in git.

# PostgreSQL connection for the API process (login role that is IN ROLE careers_api)
CAREERS_DATABASE_URL=
# PostgreSQL connection for workers (login role that is IN ROLE careers_worker)
CAREERS_WORKER_DATABASE_URL=
# PostgreSQL connection used ONLY by `python migrate.py` (owner-created migrator role)
CAREERS_MIGRATOR_DATABASE_URL=

# Supabase Auth JWT verification. Set ONE of these.
# HS256 shared secret (self-hosted Supabase default) ...
CAREERS_JWT_SECRET=
# ... or JWKS URL for asymmetric keys
CAREERS_JWKS_URL=
# Expected audience/issuer claims (Supabase: aud=authenticated, iss=<SUPABASE_URL>/auth/v1)
CAREERS_JWT_AUDIENCE=authenticated
CAREERS_JWT_ISSUER=

# Service
CAREERS_ENV=staging
CAREERS_BIND_HOST=127.0.0.1
CAREERS_BIND_PORT=
CAREERS_LOG_LEVEL=INFO
